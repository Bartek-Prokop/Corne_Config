#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp Q  &kp W  &kp E  &kp R   &kp T      &kp Y      &kp U      &kp I          &kp O                 &kp P                 &kp A  &kp S
&kp D  &kp F  &kp G  &kp H   &kp J      &kp K      &kp L      &kp BACKSPACE  &kp Z                 &kp X                 &kp C  &kp V
&kp B  &kp N  &kp M  &trans  &kp COMMA  &kp DOT    &kp LCTRL  &mo 1          &mt LEFT_SHIFT SPACE  &mt LEFT_SHIFT SPACE  &mo 2  &kp DEL
            >;
        };

        Num {
            bindings = <
&kp N1            &kp N2      &kp N3          &kp N4     &kp N5         &kp N6          &kp N7                &kp N8                 &kp N9  &kp N0  &kp EXCLAMATION  &kp DOUBLE_QUOTES
&kp LS(NUMBER_3)  &kp DOLLAR  &kp PERCENT     &kp CARET  &kp AMPERSAND  &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans           &trans
&trans            &trans      &kp UNDERSCORE  &kp MINUS  &kp PLUS       &kp EQUAL       &trans                &trans                 &trans  &trans  &trans           &trans
            >;
        };

        Func {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6     &kp F7  &kp F8   &kp F9  &kp F10  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp F11  &trans  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp F12    &trans  &trans   &trans  &trans   &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
