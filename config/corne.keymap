#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESC>;
            key-positions = <4 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp Q  &kp W  &kp E  &kp R    &kp T      &kp Y      &kp U      &kp I           &kp O                 &kp P               &kp A      &kp S
&kp D  &kp F  &kp G  &kp H    &kp J      &kp K      &kp L      &kp BACKSPACE   &kp Z                 &kp X               &kp C      &kp V
&kp B  &kp N  &kp M  &kp RET  &kp COMMA  &kp DOT    &kp LCTRL  &lt 0 LEFT_GUI  &mt LEFT_SHIFT SPACE  &mt LEFT_ALT SPACE  &lt 3 TAB  &kp DEL
            >;
        };

        layer_3 {
            bindings = <
&kp N1          &kp N2            &kp N3                &kp N4                 &kp N5             &kp N6             &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans
&kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE    &kp UP  &trans  &trans  &trans  &trans  &kp BACKSLASH
&kp LESS_THAN   &kp GREATER_THAN  &kp SLASH             &kp LEFT               &kp DOWN           &kp RIGHT          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Sym. {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Func {
            bindings = <
&kp F1          &kp F2            &kp F3                &kp F4                 &kp F5             &kp F6             &kp F7  &kp F8   &kp F9  &kp F10  &kp F11  &kp F12
&kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE    &trans  &kp F11  &trans  &trans   &trans   &kt SLASH
&kp LESS_THAN   &kp GREATER_THAN  &kp BACKSLASH         &kp ENTER              &trans             &kp F12            &trans  &trans   &trans  &trans   &trans   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Func {
            if-layers = <2 2>;
            then-layer = <3>;
        };
    };
};
