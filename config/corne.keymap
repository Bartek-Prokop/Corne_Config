#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp Q  &kp W  &kp E  &kp R   &kp T   &kp Y     &kp U   &kp I   &kp O   &kp P   &kp A   &kp S
&kp D  &kp F  &kp G  &kp H   &kp J   &kp K     &kp L   &trans  &kp Z   &kp X   &kp C   &kp V
&kp B  &kp N  &kp M  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Num {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6    &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Func {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6     &kp F7  &kp F8   &kp F9  &kp F10  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp F11  &trans  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp F12    &trans  &trans   &trans  &trans   &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
