#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESC>;
            key-positions = <4 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp Q  &kp W  &kp E  &kp R    &kp T      &kp Y      &kp U      &kp I           &kp O                 &kp P               &kp A      &kp S
&kp D  &kp F  &kp G  &kp H    &kp J      &kp K      &kp L      &kp BACKSPACE   &kp Z                 &kp X               &kp C      &kp V
&kp B  &kp N  &kp M  &kp RET  &kp COMMA  &kp DOT    &kp LCTRL  &lt 0 LEFT_GUI  &mt LEFT_SHIFT SPACE  &mt LEFT_ALT SPACE  &lt 3 TAB  &kp DEL
            >;
        };

        Num. {
            bindings = <
&kp N1          &kp N2            &kp N3                &kp N4                 &kp N5             &kp N6             &kp N7      &kp N8     &kp N9     &kp N0     &kp TAB  &trans
&kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE    &kp UP      &kp ENTER  &trans     &trans     &trans   &kp BACKSLASH
&kp LESS_THAN   &kp GREATER_THAN  &kp SLASH             &kp LEFT               &kp DOWN           &kp RIGHT          &kp DELETE  &trans     &kp SPACE  &kp SPACE  &trans   &kp BACKSPACE
            >;
        };

        Sym. {
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp LS(NUMBER_3)  &kp DOLLAR      &kp PERCENT  &kp CARET    &kp AMPERSAND  &kp ASTERISK    &trans  &trans  &trans  &trans
&trans           &trans             &trans            &kp APOSTROPHE  &kp TILDE    &kp POUND    &kp MINUS      &kp UNDERSCORE  &trans  &trans  &trans  &trans
&trans           &kp COLON          &kp SEMI          &kp AT_SIGN     &kp PLUS     &kp EQUAL    &trans         &trans          &trans  &trans  &trans  &trans
            >;
        };

        Func {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4      &kp F5           &kp F6              &kp F7             &kp F8   &kp F9      &kp F10  &bt BT_SEL 0  &bt BT_SEL 1
&bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp K_MUTE  &kt C_VOLUME_UP  &kp C_PLAY_PAUSE    &kp C_VOLUME_DOWN  &kp F11  &bt BT_CLR  &trans   &trans        &trans
&trans        &trans        &trans        &trans      &trans           &kp F12             &trans             &trans   &trans      &trans   &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Func {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
